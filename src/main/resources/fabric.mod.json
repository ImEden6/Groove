{
	"schemaVersion": 1,
	"id": "modid",
	"version": "${version}",
	"name": "Groove",
	"description": "A synchronized algorithmic music engine. Use /groove to control the shared session.",
	"authors": [
		"Mervyn"
	],
	"license": "CC0-1.0",
	"icon": "assets/modid/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mervyn.groove.GrooveMod"
		],
		"client": [
			"com.mervyn.groove.client.GrooveModClient"
		]
	},
	"accessWidener": "groove.accesswidener",
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"trinkets": "*"
	}
}
